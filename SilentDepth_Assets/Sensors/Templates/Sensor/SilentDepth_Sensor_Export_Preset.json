{
  "engine": "UE4.27",
  "fbx_binary_version": 7400,
  "fbx_label": "FBX 2018 compatible",
  "axis_forward": "-Y",
  "axis_up": "Z",
  "apply_unit_scale": true,
  "global_scale": 1.0,
  "embed_textures": false,
  "object_types": [
    "MESH"
  ],
  "use_space_transform": true,
  "bake_space_transform": false,
  "mesh_smooth_type": "FACE",
  "use_tspace": true,
  "bake_anim": false,
  "outputs": [
    "FBX/[SENSOR_ID]_LOD0.fbx",
    "FBX/[SENSOR_ID]_LOD1.fbx",
    "FBX/[SENSOR_ID]_LOD2.fbx",
    "FBX/[SENSOR_ID]_LOD3.fbx",
    "Collision/[SENSOR_ID]_COLLISION.fbx"
  ]
}
