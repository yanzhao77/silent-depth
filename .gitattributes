# Normalize all text files to LF in the working tree and the repository.
# The asset registry sha256 integrity tests hash on-disk source files, so the
# checkout line-ending policy must be pinned — autocrlf=true on Windows would
# otherwise produce CRLF working files whose hashes drift from the registry.
* text=auto eol=lf

# Binary assets must never be line-ending normalized.
*.glb binary
*.fbx binary
*.blend binary
*.blend1 binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
*.gz binary
*.pyc binary

# Unreal Engine assets are binary containers. `* text=auto eol=lf` above would
# otherwise risk normalizing them on Windows checkouts and corrupting the asset.
*.uasset binary
*.umap binary
*.uexp binary
*.ubulk binary
